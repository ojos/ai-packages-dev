# .env - Project-specific environment variables
# 
# Copy this file to .env and fill in your values.
# This file is automatically sourced by devcontainer.json on container startup.
# Values in .env will override remoteEnv settings in devcontainer.json.
# 
# IMPORTANT: .env should NOT be committed to git. Use .env.example for documentation.

# GitHub account profile to use (must match GITHUB_TOKEN_<profile> in devcontainer.json)
# Available profiles can be listed with: bash scripts/github-account-switch.sh list
GITHUB_ACTIVE_PROFILE=ojos

# Project-specific environment variables (optional)
# Example: custom API keys, debug flags, etc.
# CUSTOM_VAR=value
