{
  "name": "ojos-ai-packages-dev (standard)",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspaces/ojos-ai-packages-dev",
  "shutdownAction": "stopCompose",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:1": {
      "configureZsh": true
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "version": "latest",
      "moby": false,
      "dockerDashComposeVersion": "latest",
      "installDockerComposeSwitch": true,
      "installDockerBuildx": true
    },
    "ghcr.io/devcontainers-extra/features/ripgrep:1": {}, 
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:2.1.0": {}
  },
  "remoteEnv": {
    "GITHUB_TOKEN_OJOS": "${localEnv:GITHUB_TOKEN_OJOS}",
    "GITHUB_OWNER_OJOS": "${localEnv:GITHUB_OWNER_OJOS}",
    "GIT_AUTHOR_NAME_OJOS": "${localEnv:GIT_AUTHOR_NAME_OJOS}",
    "GIT_AUTHOR_EMAIL_OJOS": "${localEnv:GIT_AUTHOR_EMAIL_OJOS}",
    "GEMINI_API_KEY": "${localEnv:GEMINI_API_KEY}",
    "LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
  },
  "postCreateCommand": "bash -lc 'source scripts/load-project-env.sh && bash scripts/install-ai-tools.sh'",
  "postAttachCommand": "bash -lc 'source scripts/load-project-env.sh && bash scripts/on-attach.sh'",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code"
      ]
    }
  }
}
